ch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 1. O\u160?Jehovah, you have given us\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 a hope that we hold dear.\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 It\u8217?s a hope we find so thrilling\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 we want the world to hear.\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 But at times this life\u8217?s anxieties\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 are the cause of fears within,\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 And the hope that burned so brightly\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 has suddenly grown dim.\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 (Chorus)\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 You\u8217?re our strength, you\u8217?re our hope,\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 you\u8217?re our confidence.\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 Whatever we lack, you supply.\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 When we preach, when we teach,\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 we have confidence\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 because it\u8217?s on you we rely.\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 2. So Jehovah, please instill in us\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 a heart that won\u8217?t forget,\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 For you\u8217?ve always been our comfort\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 when troubled times we\u8217?ve met.\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 And these thoughts that lift and strengthen us\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 can revive that dying flame,\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 For they fill our hearts with courage\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 to speak about your name.\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 (Chorus)\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 You\u8217?re our strength, you\u8217?re our hope,\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 you\u8217?re our confidence.\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 Whatever we lack, you supply.\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 When we preach, when we teach,\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 we have confidence\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 because it\u8217?s on you we rely.\par}{\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2 (See also }{\field{\*\fldinst {HYPERLINK "https://www.jw.org/finder?wtlocale=E&prefer=lang&bible=19072013-19072014&pub=nwtsty" }}{\fldrslt{\cs4\rtlch\fcs1\alang1033\af1\ltrch\fcs0\lang1033\langnp1033\langfe1033\langfenp1033\f2\cf3\ul Psalm 7}}}{\field{\*\fldinst {HYPERLINK "https://www.jw.org/finder?wtlocale=E&prefer=l