{
  "name": "musik",
  "main": "src/index.js",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "MUSIK",
      "bucket_name": "musik"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
